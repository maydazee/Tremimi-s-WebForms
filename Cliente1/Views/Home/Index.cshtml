

@{
    Layout = null;
    ViewData["Title"] = "Clientes - Amayaway";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/imagines/AmayaAway logo.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-gray-100 flex flex-col min-h-screen m-0 p-0">

    <!-- HEADER -->
    <header class="bg-white border-b px-8 py-3 flex justify-between items-center shadow-sm">
        <div class="flex items-center space-x-8">
            <img src="~/imagines/AmayaAway logo.png" alt="Amayaway" class="h-10 object-contain" />
            <nav class="hidden md:flex space-x-6 text-sm font-medium text-gray-600">
                <a href="#" class="hover:text-blue-600">Inicio</a>
                <a href="#" class="hover:text-blue-600">Gestionar <i class="fas fa-chevron-down text-xs"></i></a>
                <a href="#" class="hover:text-blue-600">Reportes <i class="fas fa-chevron-down text-xs"></i></a>
                <a href="#" class="text-blue-600 font-bold border-b-2 border-blue-600 pb-1">Clientes</a>
                <a href="#" class="hover:text-blue-600">Vuelos <i class="fas fa-chevron-down text-xs"></i></a>
                <a href="#" class="hover:text-blue-600">Empleados <i class="fas fa-chevron-down text-xs"></i></a>
            </nav>
        </div>
        <div class="flex items-center space-x-4">
            <button class="text-gray-500 hover:text-blue-600"><i class="far fa-bell text-lg"></i></button>
            <div class="flex items-center space-x-2">
                <div class="w-9 h-9 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm">MG</div>
                <div class="text-xs">
                    <p class="font-bold text-gray-800">María Gómez</p>
                    <p class="text-gray-400">Administrador</p>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="max-w-7xl mx-auto p-6 w-full flex-grow">

        <div class="flex justify-between items-start mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Clientes</h1>
                <p class="text-xs text-gray-500">Gestiona la información de tus clientes. Puedes registrar, editar, consultar y desactivar clientes.</p>
            </div>
            <button onclick="abrirModalCrear()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium shadow transition">
                + Nuevo cliente
            </button>
        </div>

        <!-- TARJETAS DE MÉTRICAS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-4 rounded-xl shadow-sm border flex items-center space-x-4">
                <div class="p-3 bg-blue-100 text-blue-600 rounded-lg"><i class="fas fa-users text-lg"></i></div>
                <div>
                    <p class="text-xl font-bold">@ViewBag.TotalClientes</p>
                    <p class="text-xs text-gray-500">Total de clientes</p>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl shadow-sm border flex items-center space-x-4">
                <div class="p-3 bg-green-100 text-green-600 rounded-lg"><i class="fas fa-user-check text-lg"></i></div>
                <div>
                    <p class="text-xl font-bold">@ViewBag.ClientesActivos</p>
                    <p class="text-xs text-gray-500">Clientes activos</p>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl shadow-sm border flex items-center space-x-4">
                <div class="p-3 bg-sky-100 text-sky-600 rounded-lg"><i class="fas fa-chart-line text-lg"></i></div>
                <div>
                    <p class="text-xl font-bold">@ViewBag.NuevosEsteMes</p>
                    <p class="text-xs text-gray-500">Nuevos este mes</p>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl shadow-sm border flex items-center space-x-4">
                <div class="p-3 bg-red-100 text-red-600 rounded-lg"><i class="fas fa-user-clock text-lg"></i></div>
                <div>
                    <p class="text-xl font-bold">@ViewBag.ClientesInactivos</p>
                    <p class="text-xs text-gray-500">Clientes inactivos</p>
                </div>
            </div>
        </div>

        <!-- FILTROS -->
        <form method="get" asp-action="Index" class="bg-white p-4 rounded-xl shadow-sm border mb-6 flex flex-wrap gap-4 items-center justify-between">
            <div class="flex-1 min-w-[200px] relative">
                <i class="fas fa-search absolute left-3 top-3 text-gray-400 text-xs"></i>
                <input type="text" name="buscar" value="@ViewBag.BuscarActual" placeholder="Buscar por nombre, correo o teléfono..." class="w-full pl-8 pr-3 py-1.5 border rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="flex gap-3 text-xs items-end">
                <div>
                    <label class="block text-[10px] text-gray-400 mb-1">Estado</label>
                    <select name="estado" class="border rounded-lg p-1.5 bg-gray-50 text-xs">
                        <option value="Todos" selected="@(ViewBag.EstadoActual == "Todos")">Todos</option>
                        <option value="Activo" selected="@(ViewBag.EstadoActual == "Activo")">Activo</option>
                        <option value="Inactivo" selected="@(ViewBag.EstadoActual == "Inactivo")">Inactivo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] text-gray-400 mb-1">Tipo de cliente</label>
                    <select name="tipo" class="border rounded-lg p-1.5 bg-gray-50 text-xs">
                        <option value="Todos" selected="@(ViewBag.TipoActual == "Todos")">Todos</option>
                        <option value="Regular" selected="@(ViewBag.TipoActual == "Regular")">Regular</option>
                        <option value="VIP" selected="@(ViewBag.TipoActual == "VIP")">VIP</option>
                    </select>
                </div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg font-medium transition">Filtrar</button>
                <a href="@Url.Action("Index")" class="border px-3 py-1.5 rounded-lg text-blue-600 bg-blue-50 font-medium hover:bg-blue-100 transition">Limpiar filtros</a>
            </div>
        </form>

        <!-- TABLA -->
        <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
            <table class="w-full text-left text-xs text-gray-600">
                <thead class="bg-gray-50 border-b font-bold text-gray-700">
                    <tr>
                        <th class="p-3">Cliente</th>
                        <th class="p-3">Correo</th>
                        <th class="p-3">Teléfono</th>
                        <th class="p-3">Fecha de registro</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cliente in Model)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="p-3 font-semibold flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-[10px]"><i class="fas fa-user"></i></span>
                                    @cliente.Nombre
                                </td>
                                <td class="p-3">@cliente.Correo</td>
                                <td class="p-3">@cliente.Telefono</td>
                                <td class="p-3">@cliente.FechaRegistro</td>
                                <td class="p-3">
                                    @if (cliente.Estado == "Activo")
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-bold text-[10px]">● Activo</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-bold text-[10px]">● Inactivo</span>
                                    }
                                </td>
                                <td class="p-3 text-center space-x-1">
                                    <button onclick="verCliente('@cliente.Nombre', '@cliente.Correo', '@cliente.Telefono', '@cliente.Estado', '@cliente.TipoCliente')" class="p-1 bg-blue-100 text-blue-600 hover:bg-blue-200 rounded"><i class="far fa-eye"></i></button>
                                    <button onclick="editarCliente(@cliente.Id, '@cliente.Nombre', '@cliente.Correo', '@cliente.Telefono', '@cliente.Estado', '@cliente.TipoCliente')" class="p-1 bg-blue-100 text-blue-600 hover:bg-blue-200 rounded"><i class="fas fa-pen"></i></button>
                                    <button onclick="confirmarEliminar(@cliente.Id, '@cliente.Nombre')" class="p-1 bg-red-100 text-red-600 hover:bg-red-200 rounded"><i class="fas fa-trash-alt"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-6 text-center text-gray-400">No se encontraron clientes con los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="p-3 bg-gray-50 border-t flex justify-between items-center text-xs text-gray-500">
                <p>Mostrando @Model.Count() clientes</p>
            </div>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="bg-[#0a2558] text-white pt-10 pb-6 px-8 mt-auto">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 text-xs">
            <div>
                <img src="~/imagines/AmayaAway logo.png" alt="Amayaway" class="h-14 object-contain mb-3 brightness-200" />
                <p class="text-gray-300">Agencia de viajes especializada en experiencias inolvidables alrededor del mundo.</p>
            </div>
            <div>
                <h4 class="font-bold text-sm mb-3">Explora</h4>
                <ul class="space-y-1.5 text-gray-300">
                    <li>› Inicio</li>
                    <li>› Vuelos</li>
                    <li>› Paquetes turísticos</li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-sm mb-3">Información</h4>
                <ul class="space-y-1.5 text-gray-300">
                    <li>› Sobre nosotros</li>
                    <li>› Términos y condiciones</li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-sm mb-3">Contacto</h4>
                <p class="mb-1"><i class="fas fa-phone-alt mr-1"></i> +503 2214 5678</p>
                <p class="mb-1"><i class="fas fa-envelope mr-1"></i> info@amayaway.com</p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto border-t border-white/10 pt-4 text-[11px] text-gray-400">
            <p>© 2026 Amayaway. Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- MODAL CREAR -->
    <div id="modalCrear" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-xl">
            <h3 class="text-lg font-bold mb-4">Registrar Nuevo Cliente</h3>
            <form asp-action="Crear" method="post" class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold mb-1">Nombre Completo</label>
                    <input type="text" name="Nombre" required class="w-full border rounded p-2 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>
                <div>
                    <label class="block font-semibold mb-1">Correo Electrónico</label>
                    <input type="email" name="Correo" required class="w-full border rounded p-2 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>
                <div>
                    <label class="block font-semibold mb-1">Teléfono</label>
                    <input type="text" name="Telefono" required class="w-full border rounded p-2 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold mb-1">Estado</label>
                        <select name="Estado" class="w-full border rounded p-2">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Tipo</label>
                        <select name="TipoCliente" class="w-full border rounded p-2">
                            <option value="Regular">Regular</option>
                            <option value="VIP">VIP</option>
                        </select>
                    </div>
                </div>
                <div class="flex justify-end gap-2 mt-4 pt-2 border-t">
                    <button type="button" onclick="cerrarModales()" class="px-3 py-1.5 border rounded">Cancelar</button>
                    <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded font-medium">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDITAR -->
    <div id="modalEditar" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-xl">
            <h3 class="text-lg font-bold mb-4">Editar Cliente</h3>
            <form asp-action="Editar" method="post" class="space-y-3 text-xs">
                <input type="hidden" id="editId" name="Id" />
                <div>
                    <label class="block font-semibold mb-1">Nombre Completo</label>
                    <input type="text" id="editNombre" name="Nombre" required class="w-full border rounded p-2" />
                </div>
                <div>
                    <label class="block font-semibold mb-1">Correo Electrónico</label>
                    <input type="email" id="editCorreo" name="Correo" required class="w-full border rounded p-2" />
                </div>
                <div>
                    <label class="block font-semibold mb-1">Teléfono</label>
                    <input type="text" id="editTelefono" name="Telefono" required class="w-full border rounded p-2" />
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold mb-1">Estado</label>
                        <select id="editEstado" name="Estado" class="w-full border rounded p-2">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Tipo</label>
                        <select id="editTipo" name="TipoCliente" class="w-full border rounded p-2">
                            <option value="Regular">Regular</option>
                            <option value="VIP">VIP</option>
                        </select>
                    </div>
                </div>
                <div class="flex justify-end gap-2 mt-4 pt-2 border-t">
                    <button type="button" onclick="cerrarModales()" class="px-3 py-1.5 border rounded">Cancelar</button>
                    <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded font-medium">Actualizar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- FORMULARIO ELIMINAR -->
    <form id="formEliminar" asp-action="Eliminar" method="post" class="hidden">
        <input type="hidden" id="deleteId" name="id" />
    </form>

    <script>
            function abrirModalCrear() {
                document.getElementById('modalCrear').classList.remove('hidden');
            }

            function editarCliente(id, nombre, correo, telefono, estado, tipo) {
                document.getElementById('editId').value = id;
                document.getElementById('editNombre').value = nombre;
                document.getElementById('editCorreo').value = correo;
                document.getElementById('editTelefono').value = telefono;
                document.getElementById('editEstado').value = estado;
                document.getElementById('editTipo').value = tipo;
                document.getElementById('modalEditar').classList.remove('hidden');
            }

            function verCliente(nombre, correo, telefono, estado, tipo) {
                alert(`DETALLES DEL CLIENTE:\n\nNombre: ${nombre}\nCorreo: ${correo}\nTeléfono: ${telefono}\nEstado: ${estado}\nTipo: ${tipo}`);
            }

            function confirmarEliminar(id, nombre) {
                if (confirm(`¿Estás seguro de que deseas eliminar al cliente "${nombre}"?`)) {
                    document.getElementById('deleteId').value = id;
                    document.getElementById('formEliminar').submit();
                }
            }

            function cerrarModales() {
                document.getElementById('modalCrear').classList.add('hidden');
                document.getElementById('modalEditar').classList.add('hidden');
            }
    </script>
</body>
</html>