@{
    ViewData["Title"] = "Contacto";
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/Contacto.css" asp-append-version="true" />
<header>
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <img src="~/imagenes/logo.png" alt="Logo Tremimi's" class="navbar-logo" />
                <div class="lh-1">
                    <span class="brand-title">TREMIMI'S</span>
                    <small class="brand-subtitle">SOFTWARE</small>
                    <small class="d-block text-white-50" style="font-size: 0.55rem; letter-spacing: 0.5px;">IDEAS QUE SE HACEN REALIDAD</small>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2 text-center">
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#nosotros">Nosotros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#servicios">Servicios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#portafolio">Portafolio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-controller="Home" asp-action="Proceso">Proceso</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-active-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                    </li>
                </ul>

                <div class="text-center mt-2 mt-lg-0">
                    <a asp-controller="Home" asp-action="Contacto" class="btn btn-sm btn-quote rounded-pill px-3">
                        Solicitar cotización &rarr;
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<section class="py-5 position-relative">
    <div class="container py-4">
        <div class="row g-5 align-items-start">
            
            <div class="col-lg-5">
                <span class="sub-tag">&mdash;&mdash; CONTÁCTANOS</span>
                <h1 class="display-5 fw-bold mt-2 text-gradient mb-3">
                    Estamos aquí <br /> para ayudarte
                </h1>
                <p class="text-white-50 mb-4" style="max-width: 420px; font-size: 0.95rem;">
                    ¿Tienes una idea o proyecto en mente? Escríbenos y nos pondremos en contacto contigo lo antes posible. ¡Será un gusto ayudarte!
                </p>

                <div class="row g-4 mb-4">
                    <div class="col-12 d-flex align-items-start gap-3">
                        <div class="contact-icon-box">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div>
                            <small class="text-white-50 d-block">Teléfono</small>
                            <strong>+503 7654 3210</strong>
                            <small class="d-block text-white-50 mt-1" style="font-size: 0.75rem;">Lunes a viernes | 8:00 a.m. - 5:00 p.m.</small>
                        </div>
                    </div>

                    <div class="col-12 d-flex align-items-start gap-3">
                        <div class="contact-icon-box">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <small class="text-white-50 d-block">Correo electrónico</small>
                            <strong>info@tremimissoftware.com</strong>
                            <small class="d-block text-white-50 mt-1" style="font-size: 0.75rem;">Te responderemos en menos de 24 horas.</small>
                        </div>
                    </div>

                    <div class="col-12 d-flex align-items-start gap-3">
                        <div class="contact-icon-box">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <small class="text-white-50 d-block">Ubicación</small>
                            <strong>San Salvador, El Salvador</strong>
                            <small class="d-block text-white-50 mt-1" style="font-size: 0.75rem;">Oficinas principales</small>
                        </div>
                    </div>
                </div>

                <div class="row pt-3 border-top border-secondary border-opacity-25 align-items-center">
                    <div class="col-sm-6 mb-3 mb-sm-0">
                        <span class="d-block text-white-50 small mb-2">Síguenos en redes</span>
                        <small class="d-block text-white-50 mb-3" style="font-size: 0.75rem; line-height: 1.2;">
                            Conoce más sobre nosotros y mantente al día con nuestros proyectos y novedades.
                        </small>
                        <div class="d-flex gap-2">
                            <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="social-icon-btn"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="social-icon-btn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" class="social-icon-btn"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>

                    <div class="col-sm-6 border-start border-secondary border-opacity-25 ps-4">
                        <span class="quote-tag">GRANDES IDEAS TAMBIÉN EMPIEZAN CON UN MENSAJE</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="contact-card p-4 p-md-5">
                    
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="contact-icon-box border-purple-glow">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Envíanos un mensaje</h4>
                            <small class="text-white-50">Completa el formulario y te responderemos pronto.</small>
                        </div>
                    </div>

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="input-group custom-input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control custom-input" placeholder="Nombre completo *" required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="input-group custom-input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control custom-input" placeholder="Correo electrónico *" required />
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="input-group custom-input-group">
                                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                    <input type="text" class="form-control custom-input" placeholder="Asunto *" required />
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="input-group custom-input-group">
                                    <span class="input-group-text"><i class="bi bi-layers"></i></span>
                                    <select class="form-select custom-input" required>
                                        <option value="" disabled selected>¿Qué servicio te interesa? *</option>
                                        <option value="desarrollo-web">Desarrollo Web</option>
                                        <option value="software-a-medida">Software a Medida</option>
                                        <option value="diseno-ui-ux">Diseño UI/UX</option>
                                        <option value="consultoria">Consultoría Tecnológica</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="input-group custom-input-group align-items-start">
                                    <span class="input-group-text pt-2"><i class="bi bi-chat-left-text"></i></span>
                                    <textarea class="form-control custom-input" rows="4" placeholder="Mensaje *" required></textarea>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-blue-glow w-100 py-3 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-send-fill"></i> Enviar mensaje &rarr;
                                </button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</section>

<footer class="main-footer mt-5 py-4">
    <div class="container">
        <div class="footer-top-border mb-4"></div>

        <div class="row align-items-center text-center text-md-start g-4">
            
            <div class="col-lg-3 col-md-6 footer-section">
                <a class="navbar-brand d-flex align-items-center gap-2 justify-content-center justify-content-md-start" href="#">
                    <img src="~/imagenes/logo.png" alt="Logo Tremimi's" class="navbar-logo" />
                    <div class="lh-1 text-start">
                        <span class="brand-title">TREMIMI'S</span>
                        <small class="brand-subtitle">SOFTWARE</small>
                        <small class="d-block text-white-50" style="font-size: 0.65rem; letter-spacing: 0.5px; margin-top: 2px;">IDEAS QUE SE HACEN REALIDAD</small>
                    </div>
                </a>
            </div>

            <div class="col-lg-3 col-md-6 footer-section border-start-md">
                <div class="d-flex flex-column gap-2 text-white-50 fs-7 align-items-center align-items-md-start">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-envelope footer-icon"></i>
                        <span>info@tremimissoftware.com</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-telephone footer-icon"></i>
                        <span>+503 7654 3210</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-geo-alt footer-icon"></i>
                        <span>San Salvador, El Salvador</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 footer-section border-start-md text-center text-md-start">
                <span class="d-block text-white-50 small mb-2">Síguenos en nuestras redes</span>
                <div class="d-flex gap-2 justify-content-center justify-content-md-start">
                    <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-icon-btn"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-icon-btn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="social-icon-btn"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 footer-section border-start-md text-center text-md-start">
                <p class="text-white-50 mb-0 small">&copy; 2026 Tremimi's Software.</p>
                <p class="text-white-50 mb-0 small">Todos los derechos reservados.</p>
            </div>
        </div>

        <div class="footer-bottom-bar mt-4 pt-3 d-flex align-items-center gap-3">
            <span class="footer-tech-text">TECNOLOGÍA &nbsp;+&nbsp; CREATIVIDAD &nbsp;+&nbsp; RESULTADOS</span>
            <div class="flex-grow-1 footer-bottom-line"></div>
        </div>
    </div>
</footer>