@{
    ViewData["Title"] = "Nuestro Proceso";
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


<header>
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar py-2">
        <div class="container">
           
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <img src="~/imagenes/logo.png" alt="Logo Tremimi's" class="navbar-logo" />
                <div class="lh-1">
                    <span class="brand-title">TREMIMI'S</span>
                    <small class="brand-subtitle">SOFTWARE</small>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2 text-center">
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#nosotros">Nosotros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#servicios">Servicios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-active-link"asp-controller="Home" asp-action="Index">Proceso</a>
                    </li>
                    <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                    </li>
                </ul>

                <div class="text-center mt-2 mt-lg-0">
                    <a href="#contacto" class="btn btn-sm btn-quote rounded-pill px-3">
                        Solicitar cotización &rarr;
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>


<div class="container py-5">
    
    <div class="mb-5">
        <span class="sub-tag">&mdash;&mdash; NUESTRO PROCESO</span>
        <h1 class="display-4 fw-bold mt-2 text-gradient">De la idea a la realidad</h1>
        <p class="text-muted col-lg-6 mt-3 fs-6">
            Trabajamos de la mano contigo en cada etapa, asegurándonos de que tu proyecto se desarrolle de forma organizada, eficiente y con los mejores resultados.
        </p>
    </div>

    
    <div class="row g-2 align-items-center">
        
        <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
            <div class="process-card">
                <div class="icon-wrapper">
                    <i class="bi bi-chat-dots"></i>
                </div>
                <div class="step-number">01</div>
                <div class="step-title">Contacto</div>
                <p class="step-desc">
                    Nos comunicamos contigo para conocer tus necesidades y resolver tus dudas iniciales.
                </p>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
            <div class="process-card">
                <div class="icon-wrapper">
                    <i class="bi bi-search"></i>
                </div>
                <div class="step-number">02</div>
                <div class="step-title">Análisis</div>
                <p class="step-desc">
                    Estudiamos tu proyecto en detalle, analizamos objetivos y definimos la mejor estrategia.
                </p>
            </div>
        </div>

       
        <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
            <div class="process-card">
                <div class="icon-wrapper">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div class="step-number">03</div>
                <div class="step-title">Propuesta</div>
                <p class="step-desc">
                    Te presentamos una propuesta personalizada con la solución, tiempos y presupuesto.
                </p>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
            <div class="process-card">
                <div class="icon-wrapper">
                    <i class="bi bi-code-slash"></i>
                </div>
                <div class="step-number">04</div>
                <div class="step-title">Desarrollo</div>
                <p class="step-desc">
                    Nuestro equipo trabaja en la creación de tu proyecto, manteniéndote informado en cada avance.
                </p>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
            <div class="process-card">
                <div class="icon-wrapper">
                    <i class="bi bi-rocket-takeoff"></i>
                </div>
                <div class="step-number">05</div>
                <div class="step-title">Entrega</div>
                <p class="step-desc">
                    Realizamos pruebas de calidad, te entregamos el proyecto y te guiamos en su implementación.
                </p>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
            <div class="process-card">
                <div class="icon-wrapper">
                    <i class="bi bi-headset"></i>
                </div>
                <div class="step-number">06</div>
                <div class="step-title">Soporte</div>
                <p class="step-desc">
                    No te dejamos solo. Ofrecemos mantenimiento y soporte técnico para que todo siga funcionando perfectamente.
                </p>
            </div>
        </div>
    </div>
</div>
<footer class="main-footer mt-5 py-4">
    <div class="container">
       
        <div class="footer-top-border mb-4"></div>

        <div class="row align-items-center text-center text-md-start g-4">
           
            <div class="col-lg-3 col-md-6 footer-section">
                <a class="navbar-brand d-flex align-items-center gap-2 justify-content-center justify-content-md-start" href="#">
                    <img src="~/imagenes/logo.png" alt="Logo Tremimi's" class="navbar-logo" />
                    <div class="lh-1 text-start">
                        <span class="brand-title">TREMIMI'S</span>
                        <small class="brand-subtitle">SOFTWARE</small>
                        <small class="d-block text-white-50" style="font-size: 0.65rem; letter-spacing: 0.5px; margin-top: 2px;">IDEAS QUE SE HACEN REALIDAD</small>
                    </div>
                </a>
            </div>

            <div class="col-lg-3 col-md-6 footer-section border-start-md">
                <div class="d-flex flex-column gap-2 text-white-50 fs-7 align-items-center align-items-md-start">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-envelope footer-icon"></i>
                        <span>info@tremimissoftware.com</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-telephone footer-icon"></i>
                        <span>+503 7654 3210</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-geo-alt footer-icon"></i>
                        <span>San Salvador, El Salvador</span>
                    </div>
                </div>
            </div>

            
            <div class="col-lg-3 col-md-6 footer-section border-start-md text-center text-md-start">
                <span class="d-block text-white-50 small mb-2">Síguenos en nuestras redes</span>
                <div class="d-flex gap-2 justify-content-center justify-content-md-start">
                    <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-icon-btn"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-icon-btn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="social-icon-btn"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 footer-section border-start-md text-center text-md-start">
                <p class="text-white-50 mb-0 small">&copy; 2026 Tremimi's Software.</p>
                <p class="text-white-50 mb-0 small">Todos los derechos reservados.</p>
            </div>
        </div>

        <div class="footer-bottom-bar mt-4 pt-3 d-flex align-items-center gap-3">
            <span class="footer-tech-text">TECNOLOGÍA &nbsp;+&nbsp; CREATIVIDAD &nbsp;+&nbsp; RESULTADOS</span>
            <div class="flex-grow-1 footer-bottom-line"></div>
        </div>
    </div>
</footer>