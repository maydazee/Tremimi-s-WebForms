@model Paquete.Models.Paquetes

@{
    Layout = null;
    ViewData["Title"] = Model.Nombre + " - Detalle Amayaway";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/imagines/AmayaAway logo.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

    <header class="bg-white shadow-sm py-4 px-6 md:px-12 flex justify-between items-center w-full">
        <img src="~/imagines/AmayaAway logo.png" alt="Amayaway Logo" class="h-10 md:h-12 object-contain" />
        <a href="@Url.Action("Index", "Home")" class="text-xs text-sky-500 font-semibold hover:underline flex items-center gap-1">
            <i class="fas fa-arrow-left"></i> Volver a Paquetes
        </a>
    </header>

    <main class="max-w-4xl mx-auto py-10 px-6 flex-grow w-full">
        <div class="bg-white rounded-3xl shadow-lg border border-gray-100 overflow-hidden grid grid-cols-1 md:grid-cols-2">
            <img src="@Url.Content(Model.ImagenUrl)" alt="@Model.Nombre" class="w-full h-72 md:h-full object-cover" />
            
            <div class="p-6 md:p-8 flex flex-col justify-between">
                <div>
                    <span class="text-xs bg-sky-100 text-sky-600 px-3 py-1 rounded-full font-bold">Paquete Turístico</span>
                    <h1 class="text-2xl font-bold text-gray-800 mt-3 mb-2">@Model.Nombre</h1>
                    <p class="text-xs text-gray-500 leading-relaxed mb-6">@Model.Descripcion</p>

                    <h4 class="text-xs font-bold text-gray-700 uppercase mb-3">Qué incluye este paquete:</h4>
                    <ul class="space-y-2 text-xs text-gray-600 mb-6">
                        <li class="flex items-center gap-2"><i class="fas fa-plane text-sky-500"></i> @Model.Vuelos</li>
                        <li class="flex items-center gap-2"><i class="fas fa-hotel text-sky-500"></i> @Model.Hotel</li>
                        <li class="flex items-center gap-2"><i class="fas fa-car text-sky-500"></i> @Model.Transportacion</li>
                    </ul>
                </div>

                <div class="border-t pt-4 flex items-center justify-between">
                    <div>
                        <span class="text-[10px] text-gray-400 block">Precio final</span>
                        <span class="text-2xl font-extrabold text-gray-900">$@Model.Precio.ToString("N0") <span class="text-xs text-gray-500 font-normal">USD</span></span>
                    </div>
                    <button class="px-6 py-2.5 bg-sky-500 text-white rounded-xl text-xs font-bold hover:bg-sky-600 transition shadow-md">
                        Reservar ahora
                    </button>
                </div>
            </div>
        </div>
    </main>

   
    <footer class="bg-[#0a2558] text-white py-4 text-center text-[10px] text-gray-400 mt-auto">
        © 2026 <span class="text-sky-400 font-semibold">Amayaway</span>. Todos los derechos reservados.
    </footer>

</body>
</html>