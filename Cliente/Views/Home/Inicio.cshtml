@using Clientes.Models
@model Clientes.Models.Inicio

@{
    Layout = null;
    ViewData["Title"] = "Inicio Dashboard - Amayaway";
    var pendientes = ViewBag.Pendientes as List<Clientes.Models.PendienteImportante>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/imagine/AmayaAway logo.png")" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-[#f0f4f8] text-gray-800 flex flex-col min-h-screen m-0 p-0 font-sans">

    <!-- HEADER / NAV SUPERIOR UNIFICADO -->
    <header class="bg-white border-b border-gray-200 px-8 py-3 flex justify-between items-center shadow-sm sticky top-0 z-30">
        <div class="flex items-center space-x-10">
            <a href="@Url.Action("Index", "Inicio")" class="flex items-center gap-2">
                <img src="@Url.Content("~/imagine/AmayaAway logo.png")" alt="Amayaway Logo" class="h-10 object-contain" />
            </a>
            <nav class="hidden lg:flex space-x-8 text-sm font-medium text-gray-600 items-center">
                <a href="@Url.Action("Index", "Inicio")" class="text-blue-600 font-bold border-b-2 border-blue-600 pb-1">Inicio</a>
                
                <!-- MENÚ DESPLEGABLE GESTIONAR -->
                <div class="relative group py-2">
                    <button class="hover:text-blue-600 font-medium flex items-center gap-1 focus:outline-none">
                        Gestionar <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                    <div class="absolute left-0 mt-1 w-48 bg-white border border-gray-100 rounded-2xl shadow-xl py-2 hidden group-hover:block z-50">
                        <a href="@Url.Action("Index", "Paquete")" class="block px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 hover:text-blue-600">Paquetes turísticos</a>
                        <a href="@Url.Action("Index", "Home")" class="block px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 hover:text-blue-600">Clientes</a>
                        <a href="@Url.Action("Index", "Reportes")" class="block px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 hover:text-blue-600 border-t border-gray-100 mt-1 pt-2">Reportes</a>
                    </div>
                </div>

                <a href="@Url.Action("Index", "Reportes")" class="hover:text-blue-600 transition">Reportes</a>
                <a href="@Url.Action("Index", "Home")" class="hover:text-blue-600 transition">Clientes</a>
                <a href="@Url.Action("Index", "Vuelo")" class="hover:text-blue-600 transition flex items-center gap-1">Vuelos <i class="fas fa-chevron-down text-xs"></i>
<a href="@Url.Action("Index", "Empleado")" class="hover:text-blue-600 transition flex items-center gap-1">Empleados <i class="fas fa-chevron-down text-xs"></i></a>
            </nav>
        </div>
        <div class="flex items-center space-x-5">
            <button class="text-gray-500 hover:text-blue-600 relative"><i class="far fa-bell text-lg"></i></button>
            <div class="flex items-center space-x-3 border-l pl-4 border-gray-200">
                <div class="w-9 h-9 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm shadow">MG</div>
                <div class="text-xs">
                    <p class="font-bold text-gray-800">María Gómez</p>
                    <p class="text-gray-400">Administrador</p>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-grow max-w-[1400px] w-full mx-auto px-6 py-6 space-y-6">

        <!-- BIENVENIDA Y CARDS SUPERIORES -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Bienvenida, María</h1>
                <p class="text-xs text-gray-400 mt-0.5">Aquí tienes un resumen de tu actividad.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- CLIENTES -->
                <div class="border border-gray-200 rounded-2xl p-5 hover:border-blue-400 transition bg-white">
                    <div class="w-10 h-10 bg-blue-600 text-white rounded-xl flex items-center justify-center text-lg mb-3 shadow-sm">
                        <i class="fas fa-users"></i>
                    </div>
                    <p class="text-3xl font-extrabold text-gray-900">@Model.TotalClientes</p>
                    <p class="text-xs text-gray-500 font-medium mt-1">Clientes</p>
                    <a href="@Url.Action("Index", "Home")" class="text-xs text-blue-600 font-bold hover:underline mt-3 inline-block">Ver clientes →</a>
                </div>

                <!-- RESERVAS / PAQUETES -->
                <div class="border border-gray-200 rounded-2xl p-5 hover:border-blue-400 transition bg-white">
                    <div class="w-10 h-10 bg-blue-600 text-white rounded-xl flex items-center justify-center text-lg mb-3 shadow-sm">
                        <i class="fas fa-suitcase"></i>
                    </div>
                    <p class="text-3xl font-extrabold text-gray-900">@Model.TotalReservas</p>
                    <p class="text-xs text-gray-500 font-medium mt-1">Reservas</p>
                    <a href="@Url.Action("Index", "Paquete")" class="text-xs text-blue-600 font-bold hover:underline mt-3 inline-block">Ver paquetes →</a>
                </div>

                <!-- COTIZACIONES / REPORTES -->
                <div class="border border-gray-200 rounded-2xl p-5 hover:border-blue-400 transition bg-white">
                    <div class="w-10 h-10 bg-blue-600 text-white rounded-xl flex items-center justify-center text-lg mb-3 shadow-sm">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <p class="text-3xl font-extrabold text-gray-900">@Model.TotalCotizaciones</p>
                    <p class="text-xs text-gray-500 font-medium mt-1">Cotizaciones</p>
                    <a href="@Url.Action("Index", "Reportes")" class="text-xs text-blue-600 font-bold hover:underline mt-3 inline-block">Ver reportes →</a>
                </div>

                <!-- CALIFICACIÓN PROMEDIO -->
                <div class="border border-gray-200 rounded-2xl p-5 hover:border-blue-400 transition bg-white">
                    <div class="w-10 h-10 bg-blue-600 text-white rounded-xl flex items-center justify-center text-lg mb-3 shadow-sm">
                        <i class="fas fa-star"></i>
                    </div>
                    <p class="text-3xl font-extrabold text-gray-900">@Model.CalificacionPromedio.ToString("F1")</p>
                    <p class="text-xs text-gray-500 font-medium mt-1">Calificación Promedio</p>
                    <a href="@Url.Action("Index", "Vuelo")" class="text-xs text-blue-600 font-bold hover:underline mt-3 inline-block">Ver vuelos →</a>
                </div>
            </div>
        </div>

        <!-- SECCIÓN DE RESUMEN Y PENDIENTES -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- RESUMEN DE LA SEMANA -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between space-y-4">
                <div class="flex items-center gap-2">
                    <div class="p-2 bg-gradient-to-r from-orange-400 to-rose-500 text-white rounded-lg text-sm">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h2 class="text-lg font-bold text-gray-900">Resumen de la semana</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                    <!-- IMAGEN DE PLAYA PARADISÍACA -->
                    <div class="rounded-2xl overflow-hidden h-40 shadow-sm border border-gray-100">
                        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80" alt="Resort Playa Amayaway" class="w-full h-full object-cover" />
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 bg-sky-100 text-sky-600 rounded-full flex items-center justify-center font-bold text-sm"><i class="fas fa-user"></i></div>
                            <div>
                                <p class="text-lg font-extrabold text-gray-900 leading-none">@Model.ReservasConfirmadasSemana</p>
                                <p class="text-xs text-gray-500 font-medium">Reservas confirmadas</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 bg-sky-100 text-sky-600 rounded-full flex items-center justify-center font-bold text-sm"><i class="fas fa-check-circle"></i></div>
                            <div>
                                <p class="text-lg font-extrabold text-gray-900 leading-none">@Model.CotizacionesEnviadasSemana</p>
                                <p class="text-xs text-gray-500 font-medium">Cotizaciones enviadas</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 bg-sky-100 text-sky-600 rounded-full flex items-center justify-center font-bold text-sm"><i class="fas fa-user-plus"></i></div>
                            <div>
                                <p class="text-lg font-extrabold text-gray-900 leading-none">@Model.NuevosClientesSemana</p>
                                <p class="text-xs text-gray-500 font-medium">Nuevos clientes</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-2">
                    <a href="@Url.Action("Index", "Reportes")" class="text-xs text-blue-600 font-bold hover:underline inline-flex items-center gap-1">
                        Ver estadística completa <i class="fas fa-arrow-right text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- PENDIENTES IMPORTANTES -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-4">
                <div class="flex items-center gap-2">
                    <i class="far fa-bell text-gray-700 text-lg"></i>
                    <h2 class="text-lg font-bold text-gray-900">Pendientes importantes</h2>
                </div>

                <div class="divide-y divide-gray-100 space-y-3">
                    @if (pendientes != null)
                    {
                        foreach (var item in pendientes)
                        {
                            <div class="pt-3 flex items-start gap-4">
                                <div class="text-blue-600 text-lg pt-1">
                                    @if (item.TipoIcono == "plane") { <i class="fas fa-plane-departure"></i> }
                                    else if (item.TipoIcono == "user") { <i class="far fa-user"></i> }
                                    else { <i class="far fa-calendar-alt"></i> }
                                </div>
                                <div class="flex-grow">
                                    <p class="font-bold text-xs text-gray-900">@item.Titulo</p>
                                    <p class="text-[11px] text-gray-400">@item.CodigoRef</p>
                                    <span class="text-[10px] text-gray-500 font-semibold block mt-0.5">@item.Vencimiento</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        <!-- TAREAS DE HOY (CONECTADAS A LOS MÓDULOS) -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-4">
            <div class="flex items-center gap-3">
                <div class="text-blue-600 text-xl"><i class="fas fa-list-ul"></i></div>
                <h2 class="text-lg font-bold text-gray-900">Tareas de hoy</h2>
            </div>

            <div class="divide-y divide-gray-100">
                <a href="@Url.Action("Index", "Home")" class="py-3.5 flex justify-between items-center hover:bg-gray-50/50 px-2 rounded-xl transition cursor-pointer block">
                    <div class="flex items-center gap-4">
                        <div class="w-9 h-9 bg-blue-600 text-white rounded-xl flex items-center justify-center text-sm shadow-sm">
                            <i class="far fa-envelope"></i>
                        </div>
                        <div>
                            <p class="font-bold text-xs text-gray-900">Responder correos de clientes</p>
                            <p class="text-[11px] text-gray-400">Tiene @Model.CorreosSinLeer correos sin leer</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="px-3 py-1 bg-sky-400 text-white text-[10px] font-bold rounded-full">@Model.CorreosSinLeer pendiente</span>
                        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
                    </div>
                </a>

                <a href="@Url.Action("Index", "Vuelo")" class="py-3.5 flex justify-between items-center hover:bg-gray-50/50 px-2 rounded-xl transition cursor-pointer block">
                    <div class="flex items-center gap-4">
                        <div class="w-9 h-9 bg-blue-600 text-white rounded-xl flex items-center justify-center text-sm shadow-sm">
                            <i class="fas fa-plane"></i>
                        </div>
                        <div>
                            <p class="font-bold text-xs text-gray-900">Confirmaciones de reservas de vuelos</p>
                            <p class="text-[11px] text-gray-400">@Model.ReservasPorConfirmar reservas para confirmar</p>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-xs text-gray-400"></i>
                </a>

                <a href="@Url.Action("Index", "Reportes")" class="py-3.5 flex justify-between items-center hover:bg-gray-50/50 px-2 rounded-xl transition cursor-pointer block">
                    <div class="flex items-center gap-4">
                        <div class="w-9 h-9 bg-blue-600 text-white rounded-xl flex items-center justify-center text-sm shadow-sm">
                            <i class="far fa-credit-card"></i>
                        </div>
                        <div>
                            <p class="font-bold text-xs text-gray-900">Revisión de pagos de clientes</p>
                            <p class="text-[11px] text-gray-400">@Model.PagosPendientes pagos pendientes</p>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-xs text-gray-400"></i>
                </a>

                <a href="@Url.Action("Index", "Paquete")" class="py-3.5 flex justify-between items-center hover:bg-gray-50/50 px-2 rounded-xl transition cursor-pointer block">
                    <div class="flex items-center gap-4">
                        <div class="w-9 h-9 bg-blue-600 text-white rounded-xl flex items-center justify-center text-sm shadow-sm">
                            <i class="fas fa-suitcase"></i>
                        </div>
                        <div>
                            <p class="font-bold text-xs text-gray-900">Paquetes turísticos por confirmar</p>
                            <p class="text-[11px] text-gray-400">@Model.CotizacionesPorPagar paquetes listos para enviar</p>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-xs text-gray-400"></i>
                </a>
            </div>
        </div>

    </main>

    <!-- FOOTER AZUL COMPLETO INSTITUCIONAL -->
    <footer class="bg-[#0a2558] text-white pt-10 pb-6 px-8 mt-auto">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 text-xs">
            <div>
                <img src="@Url.Content("~/imagine/AmayaAway logo.png")" alt="Amayaway Logo" class="h-12 object-contain mb-3 brightness-200" />
                <p class="text-gray-300 leading-relaxed">Hacemos de tus viajes una experiencia inolvidable. Descubre tu mundo.</p>
                <div class="flex space-x-3 mt-4 text-base text-gray-300">
                    <i class="fab fa-facebook hover:text-white cursor-pointer"></i>
                    <i class="fab fa-instagram hover:text-white cursor-pointer"></i>
                    <i class="fab fa-youtube hover:text-white cursor-pointer"></i>
                    <i class="fab fa-whatsapp hover:text-white cursor-pointer"></i>
                </div>
            </div>
            <div>
                <h4 class="font-bold text-sm mb-3">Explora</h4>
                <ul class="space-y-1.5 text-gray-300">
                    <li><a href="@Url.Action("Index", "Inicio")" class="hover:underline">› Inicio</a></li>
                    <li><a href="@Url.Action("Index", "Vuelo")" class="hover:underline">› Vuelos</a></li>
                    <li><a href="@Url.Action("Index", "Paquete")" class="hover:underline">› Paquetes turísticos</a></li>
                    <li><a href="@Url.Action("Index", "Home")" class="hover:underline">› Clientes</a></li>
                    <li><a href="@Url.Action("Index", "Reportes")" class="hover:underline">› Reportes</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-sm mb-3">Información</h4>
                <ul class="space-y-1.5 text-gray-300">
                    <li>› Sobre nosotros</li>
                    <li>› Preguntas frecuentes</li>
                    <li>› Términos y condiciones</li>
                    <li>› Política de privacidad</li>
                    <li>› Aviso legal</li>
                    <li>› Blog</li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-sm mb-3">Contacto</h4>
                <p class="mb-1"><i class="fas fa-phone-alt mr-1"></i> +503 1234 5678</p>
                <p class="mb-1"><i class="fas fa-envelope mr-1"></i> info@amayaway.com</p>
                <p class="mb-3"><i class="fas fa-map-marker-alt mr-1"></i> Soyapango, El Salvador</p>
                
                <p class="font-semibold mb-1">Suscríbete a nuestro boletín</p>
                <p class="text-[10px] text-gray-400 mb-2">Recibe ofertas exclusivas y noticias de viajes.</p>
                <div class="flex">
                    <input type="email" placeholder="Tu correo electrónico" class="px-3 py-1.5 rounded-l-lg text-gray-800 text-xs focus:outline-none w-full" />
                    <button class="bg-sky-400 hover:bg-sky-500 text-white px-3 py-1.5 rounded-r-lg font-bold text-xs">Suscribirse</button>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto border-t border-white/10 pt-4 flex justify-between items-center text-[11px] text-gray-400">
            <p>© 2026 <span class="text-sky-400 font-semibold">Amayaway</span> Air & Travel. Todos los derechos reservados.</p>
            <div class="flex space-x-3 text-lg text-gray-300">
                <i class="fab fa-cc-visa"></i>
                <i class="fab fa-cc-mastercard"></i>
                <i class="fab fa-cc-amex"></i>
                <i class="fab fa-cc-paypal"></i>
            </div>
        </div>
    </footer>

</body>
</html>