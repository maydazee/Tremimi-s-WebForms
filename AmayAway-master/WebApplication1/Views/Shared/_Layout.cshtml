<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Amayaway</title>

    <link rel="stylesheet" href="~/css/styleHome.css" asp-append-version="true" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    
    <header class="header-principal">

       
        <div class="logo">
           
            <a asp-controller="Home" asp-action="Index">
                <img src="~/Recursos/logo/logoAmaya.png" alt="Logo Amayaway" />
            </a>
        </div>


       
        <nav class="menu-principal">

            <a asp-controller="VistaUsuario" asp-action="Index">
                Inicio
            </a>

            <a href="#">
                Destino
            </a>

            <a href="#">
                Paquetes
            </a>

            <a asp-controller="VistaUsuario" asp-action="Hoteles">
                Hoteles
            </a>

            <a href="#">
                Actividades
            </a>

            <a href="#">
                Promociones
            </a>

            <a href="#">
                Contacto
            </a>

        </nav>


       
        <div class="acciones-header">

            <a href="#" class="btn-iniciar">
                Inicio sesión
            </a>

            <a href="#" class="btn-registrar">
                Registrar
            </a>

        </div>

    </header>


   
    <main>
        @RenderBody()
    </main>


    
   <footer class="footer-principal">

       <div class="footer-inicio">
         <div class="logo">

            <a asp-controller="Home" asp-action="Index">
                <img src="~/Recursos/logo/logoAmaya.png" alt="Logo Amayaway" />
            </a>
        </div>
        <h4>Hacemos tus viajes </h4>
        <br />
        <br />
        <h4>Experiencias inolvidables</h4>
        <br />
        <br />
        <h4>Descubre tu mundo</h4> 
            <br />
            <br />

        <div class="footer-Redes">
                <a href="https://www.facebook.com/?locale=es_LA" target="_blank">
                    <img src="~/Recursos/iconos/logofacebook.png" alt="Facebook" />
                </a>
                <br />
                <a href="https://www.instagram.com/" target="_blank">
                    <img src="~/Recursos/iconos/logoInsta.png" alt="Instagram" />
                </a>
                <br />
                <a href="https://www.youtube.com/" target="_blank">
                    <img src="~/Recursos/iconos/logoyutu.png" alt="YouTube" />
                </a>
                <br />
                <a href="https://web.whatsapp.com/" target="_blank">
                    <img src="~/Recursos/iconos/logoWhat.png" alt="WhatsApp" />
                </a>
                
        </div>



        </div>







    <div class="footer-seccion">

        <h3>Explora</h3>

        <a href="#">
            <i class="bi bi-chevron-right"></i>
            Inicio
        </a>

        <a href="#">
            <i class="bi bi-chevron-right"></i>
            Destinos
        </a>

        <a href="#">
            <i class="bi bi-chevron-right"></i>
            Paquetes
        </a>

        <a href="#">
            <i class="bi bi-chevron-right"></i>
            Hoteles
        </a>

        <a href="#">
            <i class="bi bi-chevron-right"></i> 
            Actividades
        </a>

        <a href="#">
            <i class="bi bi-chevron-right"></i>
            Promociones
        </a>

    </div>
    
        <div class="footer-seccion">
            <h3>Información</h3>
            <a href="#">
                <i class="bi bi-chevron-right"></i>
                Sobre nosotros
            </a>
            <a href="#">
                <i class="bi bi-chevron-right"></i>
                Preguntas frecuentes
            </a>
            <a href="#">
                <i class="bi bi-chevron-right"></i>
                Terminos y condiciones
            </a>
            <a href="#">
                <i class="bi bi-chevron-right"></i>
                Política de privacidad
            </a>
            <a href="#">
                <i class="bi bi-chevron-right"></i>
                Aviso legal
            </a>
            <a href="#">
                <i class="bi bi-chevron-right"></i>
                blog
            </a>
    </div>

        <div class="footer-contacto">

            <h3>Contacto</h3>

            <div class="footer-contacto-item">
                <i class="bi bi-telephone-fill"></i>
                <span>+503 1234-5678</span>
            </div>

            <div class="footer-contacto-item">
                <i class="bi bi-envelope-fill"></i>
                <span>info@amayaway.com</span>
            </div>

            <div class="footer-contacto-item">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Soyapango, El Salvador</span>
            </div>
            </div>


            
            <div class="footer-correo">

                <h3>Suscríbete a nuestro boletín</h3>

                <p>Recibe ofertas exclusivas y noticias de viajes.</p>

                <form class="form-correo">

                    <input type="email"
                           placeholder="Tu correo electrónico" />

                    <button type="submit">
                        Suscribirme
                        <i class="bi bi-send-fill"></i>
                    </button>

                </form>

            </div>


            <div class="footer-bottom">

                
                <div class="footer-copyright">

                    <p>
                        © 2026
                        <span>Amayaway</span>
                        Air & Travel. Todos los derechos reservados.
                    </p>

                </div>


               
                <div class="footer-pagos">

                    <img src="~/Recursos/pagos/visa.png"
                         alt="Visa" />

                    <img src="~/Recursos/pagos/master.png"
                         alt="Mastercard" />

                    <img src="~/Recursos/pagos/amex.png"
                         alt="American Express" />

                    <img src="~/Recursos/pagos/paypal.png"
                         alt="PayPal" />

                </div>

            </div>


</footer>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>